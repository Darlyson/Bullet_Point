# Chave do seu projeto para que o usuário final só clique em "Entrar com o Google".
# Copie este arquivo para `.env` e preencha com os dados do seu projeto antes de gerar o instalador (`npm run desktop:build`).

VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

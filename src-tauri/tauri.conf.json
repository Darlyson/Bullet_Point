{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bullet Point",
  "version": "0.1.0",
  "identifier": "com.darlyson.bulletpoint",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bullet Point",
        "width": 1600,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#0d0d0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "Produtividade integrada",
    "publisher": "Darlyson"
  }
}
